{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niceoneobsidian/universal-social-intelligence/blob/main/schemas/ocif-usie-evidence-v0.1.schema.json",
  "title": "USIE to OCIF evidence envelope",
  "description": "Draft contract only. This schema does not imply that USIE export or OCIF import is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "producer",
    "source",
    "capture",
    "artifacts",
    "extraction",
    "warnings"
  ],
  "properties": {
    "contract_id": {
      "const": "ocif.usie-import"
    },
    "contract_version": {
      "const": "0.1.0-draft"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "const": "USIE"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "submitted_url",
        "platform"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "submitted_url": {
          "type": "string",
          "format": "uri"
        },
        "normalized_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "status",
        "status_reason",
        "captured_at",
        "completed_at"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "blocked",
            "unavailable",
            "failed",
            "cancelled"
          ]
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "sha256",
          "byte_size",
          "media_type",
          "location"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ],
            "description": "A controlled relative reference; never an arbitrary fetch URL."
          }
        }
      }
    },
    "extraction": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "adapter",
        "schema_version",
        "fields",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "partial",
            "failed",
            "not_attempted"
          ]
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "description": "Observed or deterministically normalized fields only; model inference must be separately labeled."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
