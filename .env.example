# All optional. Defaults are safe: unauthenticated browser, public destinations only.
USIE_DATA_DIR=~/.usie
# USIE_STORAGE_STATE=~/.usie/sessions/x-personal.json   # secret; keep out of Git
USIE_NAVIGATION_TIMEOUT_MS=30000
USIE_WAIT_AFTER_NAVIGATION_MS=1200
USIE_MAX_CONCURRENCY=2
USIE_DELAY_MS_BETWEEN_JOBS=500
USIE_MAX_ATTEMPTS=3
# USIE_ALLOW_PRIVATE_HOSTS=0   # leave off unless you knowingly capture internal pages
